document.addEventListener("DOMContentLoaded", () => {
    protectAgentPage_();
    loadAgentWelcome_();
});

function protectAgentPage_() {
    const user = JSON.parse(localStorage.getItem("mnUser") || "{}");

    if (!user || user.Role !== "Agent") {
        alert("Agent access only.");
        window.location.href = "index.html";
        return;
    }

    if (user.Status && user.Status !== "Active") {
        alert("Your agent account is not active yet.");
        localStorage.removeItem("mnUser");
        window.location.href = "index.html";
    }
}

function loadAgentWelcome_() {
    const user = JSON.parse(localStorage.getItem("mnUser") || "{}");
    const welcome = document.getElementById("agentWelcomeText");

    if (welcome) {
        welcome.textContent = "Welcome, " + (user.FullName || "Agent");
    }
}

function logoutAgent_() {
    localStorage.removeItem("mnUser");
    window.location.href = "index.html";
}